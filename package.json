{
  "name": "blockterm",
  "version": "0.1.0",
  "description": "An open-source terminal with command blocks and an AI agent that types only what you approve.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "blockterm": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://blockterm.mohamedazmi.dev",
  "bugs": {
    "url": "https://github.com/pydevazmi/blockterm/issues"
  },
  "keywords": [
    "terminal",
    "shell",
    "agent",
    "ai",
    "blocks",
    "pty"
  ],
  "license": "MIT",
  "repository": "github:pydevazmi/blockterm",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "^6.0.0",
    "ai": "7.0.143",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
